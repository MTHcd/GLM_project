### Parameter Estimation

#### Newton-Raphson Algorithm Implementation up to Convergence

```{r}
##data

x <- c(1.6907, 1.7242, 1.7552, 1.7842, 1.8113, 1.8369, 1.8610, 1.8839)
n1 <- c(6 ,13,18,28,52,53,61,60)
n0 <- c(59,60,62,56,63,59,62,60) - n1
n <- c(59,60,62,56,63,59,62,60)
```

```{r}
## general
logistic <- function(z) { 
  return(ifelse(z >= 0, 
                1 / (1 + exp(-z)), 
                exp(z) / (1 + exp(z))))
}
prob <- function(beta) { # linear term in logistic
  z <- beta[1] + beta[2]*x
  return(logistic(z))
}
objective_fn <- function(beta) { # removing factorial terms
  p <- prob(beta)
  return(sum(n1*log(p+eps)+ n0*log(1-p+eps)))
}
```

```{r}
eps <- 1e-8
## Score
U <- function(beta) {
  U <- matrix(nrow=2, ncol=1)
  p <- prob(beta) # (pi_j)_j
  U[1] <- sum(n1*(1-p)-n0*p)
  U[2] <- sum(x*(n1*(1-p)-n0*p))
  return(U)
}
##Fisher Information
I <- function(beta) {
  mat <- matrix(ncol=2, nrow=2)
  p <- prob(beta)
  mat[2,2] <- sum((x^2)*(n*(1-p+eps)*(p+eps)))
  mat[1,2] <- sum(x*(n*(1-p+eps)*(p+eps)))
  mat[2,1] <- mat[1,2]
  mat[1,1] <- sum(n*(1-p+eps)*(p+eps))
  return(solve(mat))
}

## EMV Algo

EMV_algo <- function(beta) {
  new_beta <- beta + I(beta) %*% U(beta)
  return(new_beta)
}

##EMV call

resu_EMV <- function(beta_H1, beta_H2) {
  z <- rep(NA, N)
  z[1] <- objective_fn(c(beta_H1[1], beta_H2[1]))
  for (j in 2:N) {
    resu <- EMV_algo(c(beta_H1[j-1],beta_H2[j-1]))
    beta_H1[j] <- resu[1]
    beta_H2[j] <- resu[2]
    param <- c(resu[1], resu[2])
    z[j] <- objective_fn(param)
  }
  return(cbind(beta_H1, beta_H2, z))
}
```

```{r}
library(plotly)
b1_seq <- seq(-100, 100, length.out =1000)
b2_seq <- b1_seq
ll_grid <- expand.grid(beta1 = b1_seq, beta2 = b2_seq)

ll_grid$loglik <- apply(ll_grid, 1, function(row) objective_fn(c(row[1], row[2])))

g <- ggplot(ll_grid, aes(x = beta1, y = beta2, fill = loglik)) +
  geom_tile() + # gridded visualization
  scale_fill_viridis_c() + # viridis color maps; c continuous variable
  labs(title = "Log-vraisemblance sur la grille des paramètres")

ggplotly(g)
```


```{r}
####EMV calling
##params
eps <- 1e-8
N <- 100
## input EMV
beta_H1 <- rep(NA, N)
beta_H2 <- rep(NA, N)
# calling EMV
v1 <- ll_grid$beta1[which.max(ll_grid$loglik)] 
v2 <- ll_grid$beta2[which.max(ll_grid$loglik)]
init <- c(0,0, 50,-25,-100,55, v1, v2)
for (j in 1:4) {
  beta_H1[1] <- init[2*(j-1)+1]
  beta_H2[1] <- init[2*j]
  resu <- resu_EMV(beta_H1, beta_H2)
  cat("\n===== EMV", j, "=====\n")
  print(head(resu))
  print(tail(resu))
}
```

#### MLE Estimators

```{r}
MLE <- c(-60.71745, 34.27033) #EMV1 with beta_init = (0,0), z=-186.2354
beta_1_star <- MLE[1]
beta_2_star <- MLE[2]
```

### Predictions

$$\hat{\eta_{j}} = \hat{\beta}_1 + \hat{\beta}_2x_j$$

$$\hat{\pi}_j = \frac{e^{\hat{\eta_{ij}}}}{1+e^{\hat{\eta_{ij}}}}$$

#### Computing linear predicted values

```{r}
eta_hat <- beta_1_star + beta_2_star*x
eta_hat
```
#### Computing predicted proportions

```{r}
p_hat <- logistic(eta_hat)
cbind(p_hat,x)
```
#### Computing quantities Yj for each Xj

```{r}
Y <- n*p_hat
cbind(Y,x)
```

### Result Visualisation

#### Plotting observed proportions vs predicted proportions depending on dose X

```{r}
