df_plot <- data.frame(
  x = x,
  value = c(p_hat, n1/(n1+n0)),
  type  = rep(c("Predicted", "Observed"), each = length(x))
)

g <- ggplot(df_plot, aes(x = x, y = value, color = type)) +
  geom_line() +
  geom_point() + 
  scale_color_manual(values = c("Predicted" = "red", "Observed" = "green")) +
